{
	"name": "thetwopct/wporg-submission-rules",
	"type": "phpcodesniffer-standard",
	"description": "Unofficial PHP_CodeSniffer rules for WordPress.org Plugin Directory submissions",
	"keywords": [
		"phpcs",
		"WordPress",
		"WordPress.org",
		"wporg"
	],
	"homepage": "https://github.com/thetwopct/wporg-submission-rules",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "James Hunt",
			"homepage": "https://www.thetwopercent.co.uk"
		}
	],
	"require": {
		"php": ">=7.2",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
	},
	"replace": {
		"thetwopct/wp-org-submission-rules": "^1.0"
	},
	"support": {
		"issues": "https://github.com/thetwopct/wporg-submission-rules/issues",
		"source": "https://github.com/thetwopct/wporg-submission-rules"
	},
	"autoload": {
